[Unit]
Description=Fail-closed CPU Router agent
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cpu-router-agent
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
Environment=CPU_ROUTER_NODE=REPLACE_WITH_HOSTNAME
Environment=CPU_ROUTER_ARCH=REPLACE_WITH_ARCHITECTURE
Environment=CPU_ROUTER_TOOLCHAIN=REPLACE_WITH_PINNED_TOOLCHAIN
Environment=CPU_ROUTER_MAX_JOBS=2
RuntimeDirectory=cpu-router
RuntimeDirectoryMode=0700
StateDirectory=cpu-router
StateDirectoryMode=0700
UMask=0077
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
TasksMax=128
MemoryMax=8G
CPUQuota=400%

[Install]
WantedBy=default.target
